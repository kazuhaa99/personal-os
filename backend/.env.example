# Copy to backend/.env for running the API outside Docker.
# The API should connect as the restricted role (row-level security applies to it);
# migrations run as the owner. See README → Option B for creating personal_os_app.
POS_DATABASE_URL=postgresql+psycopg://personal_os_app:personal_os_app_dev@localhost:5432/personal_os
POS_MIGRATION_DATABASE_URL=postgresql+psycopg://personal_os:personal_os_dev@localhost:5432/personal_os
POS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POS_API_TOKEN=
POS_DEFAULT_TIMEZONE=Asia/Almaty
POS_LOG_LEVEL=INFO
# Email confirmation codes: set a Gmail App password here (never commit .env) …
POS_SMTP_PASSWORD=
# … or, for local development only, print the emails to the API log instead.
POS_MAIL_DEV_LOG=false
