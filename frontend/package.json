{
  "name": "personal-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "e2e": "playwright test",
    "dev:mac": "VITE_PLATFORM=macos vite",
    "build:mac": "tsc -b && VITE_PLATFORM=macos vite build --outDir dist-mac --emptyOutDir",
    "build:ios": "tsc -b && VITE_PLATFORM=ios vite build --outDir dist-ios --emptyOutDir",
    "mac:dev": "tauri dev",
    "mac:build": "node scripts/tauri-build.mjs --bundles app",
    "ios:dev": "VITE_API_BASE=${VITE_API_BASE:-http://127.0.0.1:8000/api} npm run build:ios && cap sync ios && cap run ios",
    "ios:build": "npm run build:ios && cap sync ios && cap open ios",
    "native:icons": "tauri icon public/icons/icon-1024.png -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios && capacitor-assets generate --ios --assetPath resources",
    "mac:dmg": "node scripts/tauri-build.mjs --bundles app,dmg"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@tanstack/query-sync-storage-persister": "^5.62.8",
    "@tanstack/react-query": "5.62.8",
    "@tanstack/react-query-persist-client": "^5.62.8",
    "@tauri-apps/api": "^2.12.4",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0",
    "sonner": "1.7.1",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
