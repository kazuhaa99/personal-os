# Copy to .env (never commit .env). Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Password of the restricted database role the API connects as (row-level security).
# Use letters and digits only: it is embedded in a connection URL.
POS_APP_DB_PASSWORD=change-me-to-another-long-random-string
# Optional shared secret; when set, the UI asks for it in Settings → API access token.
POS_API_TOKEN=
POS_DEFAULT_TIMEZONE=Asia/Almaty
